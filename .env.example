# URL pública del sitio (sin barra final). Se usa en sitemap, canonical, OpenGraph y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tudominio.es

# Google Analytics 4 (ej: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console: solo el valor del atributo content de la meta de verificación
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense (ej: ca-pub-1234567890123456) y IDs de bloque
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_STICKY=
